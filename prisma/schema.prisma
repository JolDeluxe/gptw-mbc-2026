generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ======================================================
// NODO DE MENÚ / ORGANIZACIÓN (Árbol N-Niveles)
// Permite cualquier profundidad:
// DIRECCION -> PRODUCTO TERMINADO -> CENTRO DE ANALISIS
// OPERACIONES -> BOTAS -> BOTAS I -> CORTE
// ======================================================
model MenuNode {
  id           Int          @id @default(autoincrement())
  nombre       String
  orden        Int          @default(1)
  imageName    String?      // Archivo de imagen asociado (ej. "1.png", "esquema.jpg")
  tipoEspecial String?      // "mbc" (color café) | "esquema" (color negro) | null (estilo normal)
  parentId     Int?
  parent       MenuNode?    @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuNode[]   @relation("MenuHierarchy")

  permisos     UserPermission[]
}

// ======================================================
// USUARIOS
// ======================================================
model User {
  id       Int              @id @default(autoincrement())
  username String           @unique
  password String
  nombre   String
  role     String           @default("NIVEL 5")

  permisos UserPermission[]
}

// ======================================================
// PERMISOS DE USUARIO
// ======================================================
model UserPermission {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  menuNodeId Int
  menuNode   MenuNode  @relation(fields: [menuNodeId], references: [id], onDelete: Cascade)
}
